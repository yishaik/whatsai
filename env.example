# Copy to `.env.local` (gitignored). Used by Vite, `vercel dev`, and Convex CLI.
# Get Gemini: https://aistudio.google.com/apikey
# Get Convex URLs: `npx convex dev` prints them on first run.

# --- Required for local AI replies / avatars / live voice ---
GEMINI_API_KEY=

# --- Optional: GPT models, Whisper STT, cloud TTS ---
OPENAI_API_KEY=

# --- Convex (from `npx convex dev`) ---
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
# HTTP actions / Convex Auth site URL, e.g. https://<deployment>.convex.site
VITE_CONVEX_SITE_URL=

# Convex dashboard env (not Vercel): CONVEX_SITE_URL, VAPID_PUBLIC_KEY,
# VAPID_PRIVATE_KEY, VAPID_SUBJECT, SITE_URL — set those in the Convex
# dashboard for production, not in this file.
