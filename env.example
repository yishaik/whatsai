# --- Preferred: Cloudflare Workers AI (replaces Gemini + OpenAI keys) ---
# Account ID: dash.cloudflare.com → any domain → the hex ID in the URL, or `npx wrangler whoami`
# Token: dash.cloudflare.com/profile/api-tokens → Create Token → Workers AI (Read)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Optional OpenAI-compatible providers (free-tier keys are fine) ---
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=

# --- Live voice ---
# Cloudflare Worker URL (already deployed): https://whatsai-voice.yishai-k.workers.dev
VOICE_AGENT_HOST=https://whatsai-voice.yishai-k.workers.dev
# Local: VOICE_AGENT_HOST=http://localhost:8787

# Optional voice providers (only needed if you pick them in Settings)
GEMINI_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# --- Optional leftover GPT path if Cloudflare is unset ---
# OPENAI_API_KEY is also used for leftover GPT chat if Cloudflare is unset.

# --- Convex ---
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# --- Open Connector (dedicated WhatsAI runtime token, never the admin token) ---
# Vercel must use workers.dev: yishaik.com has Bot Fight Mode on, and Free plan
# cannot skip it for datacenter IPs. Console stays on https://connect.yishaik.com.
OPEN_CONNECTOR_URL=https://open-connector.yishai-k.workers.dev
OPEN_CONNECTOR_TOKEN=
# Optional default chat for telegram_notify (ops bot). Numeric id or @username.
OPEN_CONNECTOR_TELEGRAM_CHAT_ID= 